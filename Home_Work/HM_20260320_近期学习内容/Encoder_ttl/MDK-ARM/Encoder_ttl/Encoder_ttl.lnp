--cpu Cortex-M3
"encoder_ttl\startup_stm32f103xb.o"
"encoder_ttl\main.o"
"encoder_ttl\gpio.o"
"encoder_ttl\usart.o"
"encoder_ttl\stm32f1xx_it.o"
"encoder_ttl\stm32f1xx_hal_msp.o"
"encoder_ttl\stm32f1xx_hal_gpio_ex.o"
"encoder_ttl\stm32f1xx_hal_uart.o"
"encoder_ttl\stm32f1xx_hal.o"
"encoder_ttl\stm32f1xx_hal_rcc.o"
"encoder_ttl\stm32f1xx_hal_rcc_ex.o"
"encoder_ttl\stm32f1xx_hal_gpio.o"
"encoder_ttl\stm32f1xx_hal_dma.o"
"encoder_ttl\stm32f1xx_hal_cortex.o"
"encoder_ttl\stm32f1xx_hal_pwr.o"
