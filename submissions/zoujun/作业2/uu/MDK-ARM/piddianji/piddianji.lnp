"piddianji\stm32f1xx_hal.o"
"piddianji\stm32f1xx_hal_rcc.o"
"piddianji\stm32f1xx_hal_rcc_ex.o"
"piddianji\stm32f1xx_hal_gpio.o"
"piddianji\stm32f1xx_hal_dma.o"
"piddianji\stm32f1xx_hal_cortex.o"
